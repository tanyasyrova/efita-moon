<% content_for :title, "#{@product.title} — EFITA MOON" %>

<div class="product-page">
  <%= link_to "Вернуться в каталог", catalog_path, class: "text-link product-page__back" %>

  <article>
    <%= render "products/gallery", product: @product %>

    <section class="product-info" aria-labelledby="product-title">
      <p class="product-info__category">
        <%= link_to @product.category.name, catalog_category_path(@product.category.slug), class: "text-link" %>
      </p>

      <h1 class="product-info__title" id="product-title"><%= @product.title %></h1>

      <div class="product-info__meta">
        <p class="product-info__price"><%= product_price(@product) %></p>
        <%= render "products/status", product: @product %>
      </div>

      <% if @product.description.present? %>
        <p class="product-info__description"><%= @product.description %></p>
      <% end %>

      <% if @product.size.present? || @product.materials.present? %>
        <dl class="product-info__details">
          <% if @product.size.present? %>
            <div class="product-info__detail">
              <dt class="product-info__detail-label">Размер</dt>
              <dd class="product-info__detail-value"><%= @product.size %></dd>
            </div>
          <% end %>

          <% if @product.materials.present? %>
            <div class="product-info__detail">
              <dt class="product-info__detail-label">Материалы</dt>
              <dd class="product-info__detail-value"><%= @product.materials %></dd>
            </div>
          <% end %>
        </dl>
      <% end %>
    </section>
  </article>
</div>
