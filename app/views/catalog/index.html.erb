<% content_for :title, "Каталог — EFITA MOON" %>

<div class="catalog-page">
  <header class="catalog-page__intro">
    <h1 class="catalog-page__title">Каталог</h1>

    <p class="catalog-page__lead">
      Украшения, собранные вручную и созданные маленькими сериями.
    </p>
  </header>

  <section class="catalog-page__categories">
    <h2 class="visually-hidden">Категории</h2>

    <% if @categories.any? %>
      <nav class="category-nav" aria-label="Категории каталога">
        <ul class="category-nav__list">
          <% @categories.each do |category| %>
            <li class="category-nav__item">
              <%= link_to category.name, catalog_category_path(category.slug), class: "category-nav__link" %>
            </li>
          <% end %>
        </ul>
      </nav>
    <% else %>
      <p class="empty-state">Категории пока не добавлены.</p>
    <% end %>
  </section>

  <section class="catalog-page__products">
    <h2 class="catalog-page__section-title">Украшения</h2>

    <% if @products.any? %>
      <div class="catalog-grid">
        <% @products.each_with_index do |product, index| %>
          <%= render "products/card", product: product, index: index %>
        <% end %>
      </div>
    <% else %>
      <p class="empty-state">В каталоге пока нет украшений.</p>
    <% end %>
  </section>
</div>
