<% content_for :title, "#{@category.name} — EFITA MOON" %>

<div class="catalog-page catalog-page--category">
  <%= link_to "Вернуться в каталог", catalog_path, class: "text-link" %>

  <header class="catalog-page__intro catalog-page__intro--compact">
    <h1 class="catalog-page__title"><%= @category.name %></h1>
    <% if @category.subtitle.present? %>
      <p class="catalog-page__subtitle"><%= @category.subtitle %></p>
    <% end %>
  </header>

  <section class="catalog-page__products">
    <h2 class="catalog-page__section-title">Украшения</h2>

    <% if @products.any? %>
      <div class="catalog-grid">
        <% @products.each_with_index do |product, index| %>
          <%= render "products/card", product: product, index: index %>
        <% end %>
      </div>
    <% else %>
      <p class="empty-state">В этой категории пока нет украшений.</p>
    <% end %>
  </section>
</div>
