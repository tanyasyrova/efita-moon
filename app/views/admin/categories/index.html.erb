<% content_for :title, "Категории — EFITA MOON Admin" %>

<section class="admin-section">
  <div class="admin-section__header">
    <div>
      <p class="admin-section__eyebrow">Каталог</p>
      <h1 class="admin-section__title">Категории</h1>
    </div>

    <%= link_to "Новая категория", new_admin_category_path, class: "admin-button" %>
  </div>

  <% if @categories.any? %>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Название</th>
            <th>Slug</th>
            <th>Позиция</th>
            <th>Состояние</th>
            <th>Товары</th>
            <th>Действия</th>
          </tr>
        </thead>
        <tbody>
          <% @categories.each do |category| %>
            <tr>
              <td><%= link_to category.name, edit_admin_category_path(category), class: "admin-link" %></td>
              <td><%= category.slug %></td>
              <td><%= category.position %></td>
              <td><%= category.active? ? "Активна" : "Неактивна" %></td>
              <td><%= category.products_count %></td>
              <td class="admin-table__actions">
                <%= link_to "Редактировать", edit_admin_category_path(category), class: "admin-link" %>
                <%= button_to "Удалить",
                              admin_category_path(category),
                              method: :delete,
                              class: "admin-link admin-link--danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="admin-empty">Категории пока не добавлены.</p>
  <% end %>
</section>
