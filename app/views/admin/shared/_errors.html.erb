<% if record.errors.any? %>
  <div class="admin-errors" role="alert">
    <h2 class="admin-errors__title">Проверьте поля формы</h2>

    <ul class="admin-errors__list">
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
