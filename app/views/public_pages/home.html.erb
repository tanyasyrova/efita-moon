<% content_for :title, "EFITA MOON" %>

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="page-container home-hero__grid">
    <div class="home-hero__copy">
      <p class="home-section-number">01</p>
      <p class="home-hero__kicker">КОГДА ТЫ —</p>
      <h1 class="home-hero__title" id="home-hero-title">свет.</h1>
      <p class="home-hero__text">Украшения ручной работы</p>
      <%= link_to catalog_path, class: "home-text-link home-text-link--arrow" do %>
        <span>Смотреть украшения</span>
        <span aria-hidden="true">→</span>
      <% end %>
    </div>

    <div class="home-hero__media">
      <%= image_tag "home/hero.jpg", alt: "Украшение EFITA MOON в мягком свете", class: "home-media-image" %>
    </div>
  </div>
</section>

<% if @featured_product.present? %>
  <section class="home-featured" aria-labelledby="home-featured-title">
    <div class="page-container">
      <p class="home-section-number">02</p>

      <article class="home-featured__grid">
        <%= link_to product_path(@featured_product.slug), class: "home-featured__media-link", aria: { label: "Смотреть изделие #{@featured_product.title}" } do %>
          <% if @featured_product.primary_image.present? %>
            <div class="home-featured__media">
              <%= image_tag @featured_product.primary_image.image.variant(:main),
                            alt: "#{@featured_product.title} — фото 1",
                            class: "home-media-image" %>
            </div>
          <% else %>
            <div class="home-featured__media image-placeholder" aria-hidden="true"></div>
          <% end %>
        <% end %>

        <div class="home-featured__content">
          <p class="home-featured__category"><%= @featured_product.category.name %></p>
          <h2 class="home-featured__title" id="home-featured-title"><%= @featured_product.title %></h2>
          <p class="home-featured__price"><%= product_price(@featured_product, precision: 0) %></p>

          <% if @featured_product.materials.present? %>
            <ul class="home-featured__materials" aria-label="Материалы">
              <% @featured_product.materials.split(/[,;\n]/).map { |material| material.strip.downcase }.reject(&:blank?).each do |material| %>
                <li><%= material %></li>
              <% end %>
            </ul>
          <% end %>

          <%= link_to product_path(@featured_product.slug), class: "home-text-link home-text-link--arrow" do %>
            <span>Смотреть изделие</span>
            <span aria-hidden="true">→</span>
          <% end %>
        </div>
      </article>
    </div>
  </section>
<% end %>

<section class="home-categories" aria-labelledby="home-categories-title">
  <div class="page-container">
    <div class="home-categories__header">
      <p class="home-section-number">03</p>
      <p class="home-categories__kicker">Каталог</p>
      <h2 class="home-categories__title" id="home-categories-title">Украшения</h2>
    </div>

    <% if @categories.any? %>
      <div class="home-categories__list">
        <% @categories.each_with_index do |category, index| %>
          <% category_image_asset_path = category_image_path(category) %>

          <article class="home-category">
            <%= link_to catalog_category_path(category.slug), class: "home-category__link" do %>
              <div class="home-category__heading">
                <div>
                  <h3><%= category.name %></h3>
                  <% if category.subtitle.present? %>
                    <p class="home-category__subtitle"><%= category.subtitle %></p>
                  <% end %>
                </div>
                <p><%= format("%02d", index + 1) %></p>
              </div>

              <div class="home-category__media<%= " image-placeholder" if category_image_asset_path.blank? %>">
                <% if category_image_asset_path.present? %>
                  <%= image_tag category_image_asset_path, alt: category.name, class: "home-media-image" %>
                <% end %>
              </div>
            <% end %>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="empty-state">Категории пока не добавлены.</p>
    <% end %>
  </div>
</section>
